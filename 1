--==========================================================================
--  Based Hub Blox Fruits: root builder. Builds the real Based Hub UI from
--  the recorded Banana declarations, then wires the original callbacks.
--==========================================================================
local function BF_BuildRoot(boot)
    local I, W = tbl17.bG(), tbl17.aE()
    if getgenv().KhForceMobileUi == true then
        pcall(function() W.ForceMobileLayout() end)
    end
    local e = tbl17.n()
    local menu = W.Menu.new({
        Icon = K.BasedLogo,
        Title = "Based Hub Blox Fruits",
        Directory = "basedhub/bloxfruits",
        Config = nil,
        ColorAnimation = nil,
        Persistence = I,
        State = boot.GeneralState,
        StateData = boot.GeneralStateData,
        OnUnload = function() e:Destroy() end,
    })
    e:Add(menu)

    local TAB_ICONS = {
        "rbxassetid://70979486241131", "rbxassetid://99199363807265",
        "rbxassetid://127234874352422", "rbxassetid://114567720540659",
        "rbxassetid://125685532120024", "rbxassetid://132868138496209",
        "rbxassetid://106205298246017",
    }
    local built_tabs, built_sections = {}, {}
    local function BF_getTab(name, idx)
        if built_tabs[name] then return built_tabs[name] end
        local tab = menu:AddTab({
            Label = name,
            Icon = TAB_ICONS[((idx - 1) % #TAB_ICONS) + 1],
            Description = "Blox Fruits",
        })
        local grid = tab:Grid({ Columns = 2 })
        built_tabs[name] = { tab = tab, grid = grid, flip = false }
        return built_tabs[name]
    end
    local function BF_getSection(tabname, groupname, tabidx)
        local key = tabname .. "\0" .. groupname
        if built_sections[key] then return built_sections[key] end
        local T = BF_getTab(tabname, tabidx)
        T.flip = not T.flip
        local sec = T.grid:AddSection({
            Title = groupname,
            Side = T.flip and "left" or "right",
        })
        -- Breathing room: nudge this section's content down below its title.
        if tabname == "Fruit And Raid" and groupname == "Fruits Options" then
            sec:AddLabel({ Label = " " })
        end
        built_sections[key] = sec
        return sec
    end

    local tab_index = {}
    for i, name in ipairs(BF_records.tabs) do tab_index[name] = i end

    local counts = { toggle = 0, button = 0, dropdown = 0, slider = 0, label = 0, input = 0 }
    for _, rec in ipairs(BF_records.controls) do
        local sec = BF_getSection(rec.tab, rec.group, tab_index[rec.tab] or 1)
        local o = rec.opts or {}
        if rec.kind == "toggle" then
            local c = sec:AddToggle({
                Label = o.Text or rec.id or "Toggle",
                Default = o.Default == true,
            })
            if o.Callback then
                if o.Default ~= nil then
                    local ok, err = pcall(o.Callback, o.Default)
                    if not ok then warn("[Based Hub Blox Fruits] default failed: " .. tostring(err)) end
                end
                c:OnChanged(function(v) o.Callback(v) end)
            end
            rec.proxy.__bf_real = c
            counts.toggle += 1
        elseif rec.kind == "button" then
            sec:AddButton({
                Label = o.Text or "Button",
                OnClick = function() if o.Func then o.Func() end end,
            })
            counts.button += 1
        elseif rec.kind == "dropdown" then
            local values = o.Values or {}
            if o.Multi then
                local c = sec:AddMultiDropdown({
                    Label = o.Text or rec.id or "Dropdown",
                    Options = values,
                    Default = o.Default,
                    OnChanged = function(v) if o.Callback then o.Callback(v) end end,
                })
                if o.Default ~= nil and o.Callback then pcall(o.Callback, o.Default) end
                rec.proxy.__bf_real = c
            else
                local c = sec:AddDropdown({
                    Label = o.Text or rec.id or "Dropdown",
                    Options = values,
                    Default = o.Default,
                    OnChanged = function(v) if o.Callback then o.Callback(v) end end,
                })
                if o.Default ~= nil and o.Callback then pcall(o.Callback, o.Default) end
                rec.proxy.__bf_real = c
            end
            counts.dropdown += 1
        elseif rec.kind == "slider" then
            local step = 1
            if o.Rounding and o.Rounding > 0 then step = 1 / (10 ^ o.Rounding) end
            local c = sec:AddSlider({
                Label = o.Text or "Slider",
                Min = o.Min or 0, Max = o.Max or 100, Step = step,
                Default = o.Default,
                OnChanged = function(v) if o.Callback then o.Callback(v) end end,
            })
            if o.Default ~= nil and o.Callback then pcall(o.Callback, o.Default) end
            rec.proxy.__bf_real = c
            counts.slider += 1
        elseif rec.kind == "label" then
            local init = rec.proxy.__bf_text or o.Text or ""
            local c = sec:AddLabel({ Label = init })
            rec.proxy.__bf_real = c
            counts.label += 1
        elseif rec.kind == "input" then
            local c = sec:AddTextBox({
                Label = o.Text or rec.id or "Input",
                Default = o.Default or "",
                Placeholder = o.Placeholder or "",
                OnChanged = function(v) if o.Callback then o.Callback(v) end end,
            })
            rec.proxy.__bf_real = c
            counts.input += 1
        end
    end

    -- Quick Start: master Auto Farm (drives the original Banana farm flags).
    do
        local T = BF_getTab("Farming", tab_index["Farming"] or 2)
        local sec = T.grid:AddSection({ Title = "Quick Start", Side = "left" })
        sec:AddLabel({ Label = "Master switch for the main farms." })
        sec:AddToggle({
            Label = "Auto Farm (Master)",
            Default = false,
            OnChanged = function(v)
                _G.Level = v
                _G.AutoFarmNear = v
            end,
        })
    end

    menu:AddSettingsTab()
    menu:SetVisible(true, true)

    local total = counts.toggle + counts.button + counts.dropdown + counts.slider + counts.label + counts.input
    warn(("[Based Hub Blox Fruits] UI built: %d controls (%d toggles, %d buttons, %d dropdowns, %d sliders, %d labels, %d inputs)"):format(
        total, counts.toggle, counts.button, counts.dropdown, counts.slider, counts.label, counts.input))
    pcall(function()
        tbl17.aB().get():Notify("Based Hub Blox Fruits loaded: " .. tostring(total) .. " features ready")
    end)
end

--  Based Hub emblem (256x256 PNG, base64), used as the menu logo.
local BASED_LOGO_B64 = ""

--  Based logo: written to disk once per load and turned into an asset id
--  for the menu rail and the watermark.
do
    local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local map = {}
    for i = 1, 64 do map[alphabet:byte(i)] = i - 1 end
    local function decode(s)
        local out = buffer.create(#s * 3 // 4 + 3)
        local n = 0
        for i = 1, #s, 4 do
            local a, b, c, d = s:byte(i, i + 3)
            local vc, vd = map[c], map[d]
            local v = map[a] * 262144 + map[b] * 4096 + (vc or 0) * 64 + (vd or 0)
            buffer.writeu8(out, n, bit32.rshift(v, 16))
            n += 1
            if vc then buffer.writeu8(out, n, bit32.band(bit32.rshift(v, 8), 255)) n += 1 end
            if vd then buffer.writeu8(out, n, bit32.band(v, 255)) n += 1 end
        end
        return buffer.readstring(out, 0, n)
    end
    local wrf, gca = K.fn("writefile"), K.fn("getcustomasset") or K.fn("getsynasset")
    if wrf and gca then
        local path = "basedhub/based_logo.png"
        local ok = pcall(wrf, path, decode(BASED_LOGO_B64))
        local ok2, id = pcall(gca, path)
        if ok and ok2 and type(id) == "string" and id ~= "" then K.BasedLogo = id end
    end
end

